  - nodeId: choice1
    speakerName: harass_1
    hideSpeakerName: 1
    text: "\uADF8\uC57C \uB10C \uC6B0\uB9AC \uC885\uC871\uC774 \uC544\uB2C8\uB2C8\uAE4C.
