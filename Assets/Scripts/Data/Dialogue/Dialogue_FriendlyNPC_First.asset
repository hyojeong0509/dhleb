    choices: []
  - nodeId: 3
    speakerName: Neria
    hideSpeakerName: 0
    text: "\uB0B4 \uC18C\uAC1C\uAC00 \uB2A6\uC5C8\uB124. \uB098\uB294 \uB124\uB9AC\uC544
      \uB77C\uACE0\uD574."
