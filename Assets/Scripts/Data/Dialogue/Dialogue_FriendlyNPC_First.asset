    choices: []
  - nodeId: 1
    speakerName: Neria
    hideSpeakerName: 1
    text: "\uC5EC\uAE30 \uC8FC\uBBFC\uB4E4\uC740 \uC804\uBD80 \uD608\uD1B5\uC744
