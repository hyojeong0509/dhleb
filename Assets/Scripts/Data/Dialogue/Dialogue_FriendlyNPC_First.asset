    choices: []
  - nodeId: 4
    speakerName: Neria
    hideSpeakerName: 0
    text: "\uB098\uB294 \uD143\uC0C8\uAC19\uC740 \uAC70 \uC5C6\uC73C\uB2C8\uAE4C
      \uAD81\uAE08\uD55C \uAC70 \uC788\uAC70\uB098 \uD798\uB4E0 \uC77C \uC788\uC73C\uBA74
